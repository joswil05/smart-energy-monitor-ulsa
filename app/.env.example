# Configuración de Firebase.
# Copiar este archivo a `app/.env` y completar. `app/.env` está en .gitignore.
#
# Estos valores identifican el proyecto y no son secretos: viajan en el bundle
# que se sirve al navegador. Lo que protege la base de datos son las reglas de
# `firebase/database.rules.json` más la cuenta con la que se inicia sesión.
VITE_FIREBASE_API_KEY="YOUR_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT.firebaseapp.com"
VITE_FIREBASE_DATABASE_URL="https://YOUR_PROJECT-default-rtdb.firebaseio.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_APP_ID"
